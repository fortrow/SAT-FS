#!/usr/bin/env sh
set -eu

if [ -z "${SATFS_CLASSPATH:-}" ]; then
  if [ -z "${SATFS_HOME:-}" ]; then
    if [ -d "/opt/sat-fs" ]; then
      SATFS_HOME="/opt/sat-fs"
    elif [ -d "/opt/cxnfs" ]; then
      SATFS_HOME="/opt/cxnfs"
    else
      SATFS_HOME="/opt/sat-fs"
    fi
  fi
  SATFS_CLASSPATH="${SATFS_HOME}/sat-fs.jar:${SATFS_HOME}/cxnfs.jar:${SATFS_HOME}/lib/*"
fi

JAVA_BIN="${JAVA_BIN:-java}"
# Intentionally split SATFS_JAVA_OPTS so callers can pass multiple JVM flags,
# e.g. SATFS_JAVA_OPTS="-Xmx4g -XX:+UseG1GC".
exec "$JAVA_BIN" ${SATFS_JAVA_OPTS:-} -cp "$SATFS_CLASSPATH" com.fortrow.satfs.Satfs "$@"
