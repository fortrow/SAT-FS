CXNFS_CLASSPATH=/opt/cxnfs/cxnfs.jar:/opt/cxnfs/lib/*
CXNFS_AUTH_CONFIG=/etc/cxnfs/server.properties
CXNFS_PAYLOAD_SPILL_DIR=/var/cache/cxnfs/payload-staging
CXNFS_REPOSITORY_ROOT=/var/lib/cxnfs/repository
CXNFS_READY_FILE=/run/cxnfs/server.ready
CXNFS_HEALTH_FILE=/run/cxnfs/server.health
CXNFS_HEALTH_MAX_AGE_MS=5000
CXNFS_HEALTH_REPORT=/var/log/cxnfs/server-health.txt
CXNFS_SHUTDOWN_FILE=/run/cxnfs/server.stop
CXNFS_DAEMON_LOCK_FILE=/run/cxnfs/server.lock
CXNFS_START_TIMEOUT_SECONDS=30
CXNFS_MAINTENANCE_DRY_RUN=false
CXNFS_MAINTENANCE_FAIL_ON_AUDIT_ISSUES=false
CXNFS_REPOSITORY_AUDIT_REPORT=/var/log/cxnfs/repository-audit.txt
CXNFS_REPOSITORY_MAINTENANCE_REPORT=/var/log/cxnfs/repository-maintenance.txt
CXNFS_REPOSITORY_ORPHAN_CONTAINER_MIN_AGE_MS=86400000
CXNFS_REPOSITORY_TEMP_FILE_MIN_AGE_MS=86400000
CXNFS_PAYLOAD_STAGING_MIN_AGE_MS=86400000
CXNFS_PAYLOAD_STAGING_CLEANUP_REPORT=/var/log/cxnfs/payload-staging-cleanup.txt
